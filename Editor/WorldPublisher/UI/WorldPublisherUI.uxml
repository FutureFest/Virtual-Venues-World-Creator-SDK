<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/VirtualVenuesSDK/Editor/WorldPublisher/UI/WorldPublisherUI.uss?fileID=7433441132597879392&amp;guid=8aeebe1b2c89fea408bd7d062514200d&amp;type=3#WorldPublisherUI" />
    <ui:ScrollView>
        <ui:VisualElement class="main-container">
            <ui:VisualElement name="setup-banner" class="setup-banner">
                <ui:Label name="setup-banner-message" class="setup-banner-message" text="This project isn't set up for VirtualVenues yet — worlds may render pink in the browser." />
                <ui:Button name="setup-fix-button" text="Fix now" class="setup-banner-button" />
            </ui:VisualElement>
            <ui:VisualElement name="auth-section" class="section">
                <ui:VisualElement class="auth-row">
                    <ui:Label name="user-greeting" class="user-greeting" />
                    <ui:Button name="auth-button" text="Login" class="auth-button" />
                </ui:VisualElement>
                <ui:VisualElement name="device-flow-container" class="device-flow-container">
                    <ui:Label text="1. On to browser on your computer or mobile device, go to url:" />
                    <ui:VisualElement class="row">
                        <ui:Button name="verification-url" class="link-button" />
                    </ui:VisualElement>
                    <ui:Label text="2. Copy and paste device code:" />
                    <ui:VisualElement class="row">
                        <ui:Label text="Device Confirmation Code: " />
                        <ui:TextField name="user-code" readonly="true" class="code-field" />
                        <ui:Button name="copy-code-button" text="Copy" class="copy-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="auth-result" class="auth-result" />
            </ui:VisualElement>
            <ui:VisualElement name="publisher-section" class="section">
                <ui:VisualElement class="field-row">
                    <ui:Label text="World Name:" class="field-row-label" />
                    <ui:TextField name="world-name-field" max-length="100" class="world-name-input" />
                </ui:VisualElement>
                <ui:Label name="world-name-error" class="error-label" />
                <ui:VisualElement class="field-row">
                    <ui:Label text="Scene:" class="field-row-label" />
                    <uie:ObjectField name="scene-selector" type="UnityEditor.SceneAsset, UnityEditor" allow-scene-objects="false" />
                    <ui:Button name="use-active-scene-button" text="Use Active Scene" class="use-active-scene-button" />
                </ui:VisualElement>
                <ui:VisualElement class="button-section">
                    <ui:Button name="publish-button" text="Publish World Map" class="primary-button" />
                </ui:VisualElement>
                <ui:VisualElement name="progress-section" class="progress-section">
                    <ui:Label name="progress-message" />
                    <ui:ProgressBar name="progress-bar" class="progress-bar" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="worlds-section" class="section">
                <ui:Label name="worlds-title" text="Published Worlds" class="subsection-title" />
                <ui:VisualElement name="world-list-container" class="world-list-container" />
                <ui:Label name="world-list-empty" text="No worlds published yet." class="empty-label" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
    <ui:Label name="version-label" class="version-label" />
</ui:UXML>
