/* World Publisher — VirtualVenues themed.
   Class names are unchanged (C# bindings rely on them); only the look is rebuilt
   on the shared tokens from VVTheme.uss (added as the base sheet by VVEditorUI). */

.main-container {
    padding: 10px;
    flex-grow: 1;
}

/* Project Setup banner */
.setup-banner {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin-bottom: 12px;
    background-color: var(--vv-warning-soft);
    border-width: 1px;
    border-color: var(--vv-warning);
    border-radius: 10px;
}

.setup-banner-message {
    flex-grow: 1;
    font-size: 11px;
    color: var(--vv-warning);
    white-space: normal;
    margin-right: 8px;
}

.setup-banner-button {
    width: 70px;
    height: 24px;
    background-color: var(--vv-warning);
    color: var(--vv-text-on-accent);
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 6px;
}

.setup-banner-button:hover {
    background-color: rgb(255, 183, 77);
}

/* Cards */
.section {
    margin-bottom: 16px;
    padding: 12px;
    background-color: var(--vv-surface);
    border-width: 1px;
    border-color: var(--vv-border);
    border-radius: 10px;
}

.subsection-title {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    color: var(--vv-text-muted);
}

/* Authentication */
#auth-section {
    padding: 8px;
}

.auth-row {
    flex-direction: row;
    align-items: center;
}

.user-greeting {
    flex-grow: 1;
    font-size: 14px;
    -unity-font-style: bold;
    margin: 0;
    color: var(--vv-success);
}

.auth-button {
    width: 100px;
    height: 26px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--vv-accent);
    -unity-font-style: bold;
    border-width: 1px;
    border-color: var(--vv-accent);
    border-radius: 6px;
}

.auth-button:hover {
    background-color: var(--vv-accent-soft);
}

.device-flow-container {
    margin: 10px 0;
    padding: 10px;
    background-color: var(--vv-accent-soft);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--vv-accent);
}

.code-field {
    flex-grow: 1;
    margin: 0 5px;
    -unity-font-style: bold;
    background-color: var(--vv-inset);
}

.link-button {
    color: var(--vv-accent);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-left;
    cursor: link;
}

.link-button:hover {
    color: var(--vv-accent-teal);
}

.auth-result {
    margin: 10px 0;
    padding: 8px;
    border-radius: 6px;
}

.auth-result-error {
    color: var(--vv-danger);
    background-color: var(--vv-danger-soft);
}

.auth-result-success {
    color: var(--vv-success);
    background-color: var(--vv-primary-soft);
}

/* World info */
.world-info-container {
    padding: 10px;
    background-color: var(--vv-inset);
    border-radius: 8px;
    margin: 5px 0;
}

/* Empty-state label (world list) */
.empty-label {
    font-size: 11px;
    color: var(--vv-text-muted);
    -unity-font-style: italic;
    padding: 6px 0;
    white-space: normal;
}

.url-row {
    flex-direction: row;
    align-items: center;
    margin: 5px 0;
    min-height: 22px;
}

.url-label {
    width: 70px;
    -unity-text-align: middle-left;
}

.url-field {
    flex-grow: 1;
    margin: 0 5px;
    background-color: var(--vv-inset);
}

.copy-button {
    width: 50px;
    height: 20px;
}

/* Scene selection */
ObjectField {
    margin: 5px 0;
    height: 22px;
}

.use-active-scene-button {
    height: 22px;
    margin: 0 0 0 4px;
    padding: 0 10px;
    flex-shrink: 0;
    font-size: 11px;
}

/* Inline label + control row */
.field-row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
}

.field-row-label {
    width: 90px;
    flex-shrink: 0;
    -unity-font-style: bold;
    color: var(--vv-text-muted);
}

.field-row > .world-name-input,
.field-row > ObjectField {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

/* Buttons */
.button-section {
    margin: 14px 0;
}

.primary-button {
    height: 30px;
    margin: 5px 0;
    background-color: var(--vv-primary);
    color: var(--vv-text-on-accent);
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 6px;
}

.primary-button:hover {
    background-color: var(--vv-primary-hover);
}

.primary-button:disabled {
    background-color: var(--vv-disabled-bg);
    color: var(--vv-disabled-text);
}

.danger-button {
    height: 30px;
    margin: 5px 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--vv-danger);
    -unity-font-style: bold;
    border-width: 1px;
    border-color: var(--vv-danger-soft);
    border-radius: 6px;
}

.danger-button:hover {
    background-color: var(--vv-danger-soft);
    color: var(--vv-danger-hover);
}

.danger-button:disabled {
    background-color: var(--vv-disabled-bg);
    color: var(--vv-disabled-text);
    border-color: var(--vv-border);
}

/* Progress */
.progress-section {
    margin: 10px 0;
    padding: 10px;
    background-color: var(--vv-inset);
    border-radius: 8px;
}

.progress-bar {
    height: 20px;
    margin: 5px 0;
}

.progress-bar > .unity-progress-bar__background {
    background-color: var(--vv-inset);
    border-radius: 6px;
}

.progress-bar > .unity-progress-bar__progress {
    background-color: var(--vv-primary);
    border-radius: 6px;
}

/* Helpers */
.row {
    flex-direction: row;
    align-items: center;
    margin: 5px 0;
}

Label {
    margin: 2px 0;
    color: var(--vv-text);
}

TextField {
    margin: 2px 0;
}

Button {
    margin: 2px 0;
}

/* Version label — re-parented into the brand header row from C# (CreateGUI). */
.version-label {
    margin-left: auto;
    align-self: flex-start;
    font-size: 10px;
    color: var(--vv-text-faint);
    -unity-text-align: middle-right;
}

/* World list */
.world-list-container {
    padding: 5px 0;
}

/* World cards */
.world-card {
    padding: 8px;
    margin: 4px 0;
    background-color: var(--vv-surface);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--vv-border);
}

.world-card:hover {
    background-color: var(--vv-surface-hover);
}

.world-card-highlight {
    border-color: var(--vv-primary);
    border-width: 1px;
}

.world-card-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}

.world-card-info {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.world-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--vv-text);
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.world-id {
    font-size: 9px;
    color: var(--vv-text-faint);
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.world-name-edit {
    flex-grow: 1;
    margin-right: 5px;
    height: 22px;
}

.world-date {
    font-size: 10px;
    color: var(--vv-text-muted);
}

.world-card-buttons {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.action-button {
    height: 24px;
    min-width: 60px;
    margin-left: 6px;
    font-size: 11px;
    border-radius: 6px;
}

.inline-button {
    height: 22px;
    min-width: 50px;
    margin-left: 4px;
    font-size: 11px;
    border-radius: 6px;
}

/* Error label */
.error-label {
    color: var(--vv-danger);
    font-size: 11px;
    margin-top: 4px;
    white-space: normal;
}

/* World name input */
.world-name-input {
    margin: 5px 0;
    height: 24px;
}
