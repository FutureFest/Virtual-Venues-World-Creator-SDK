/* NMKR Settings — VirtualVenues chrome, NMKR green accent.
   The window wears the VV theme (navy background + cards + tokens from VVTheme.uss);
   NMKR keeps its brand green by overriding the --vv-plugin-accent tokens on .nmkr-root.
   Class names are unchanged (C# bindings and the inspector host rely on them). */

/* NMKR brand override of the shared plugin-accent tokens. */
.nmkr-root {
    --vv-plugin-accent:        rgb(0, 230, 115);     /* #00E673 NMKR green */
    --vv-plugin-accent-hover:  rgb(26, 239, 133);    /* #1AEF85 */
    --vv-plugin-accent-text:   rgb(0, 0, 0);
    --vv-plugin-accent-soft:   rgba(0, 230, 115, 0.15);
}

.root {
    padding: 14px 16px;
    flex-grow: 1;
}

.header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
    padding: 10px 12px;
    background-color: var(--vv-bg-raised);
    border-width: 1px;
    border-color: var(--vv-border);
    border-radius: 12px;
}

.logo-badge {
    width: 44px;
    min-width: 44px;
    max-width: 44px;
    height: 44px;
    min-height: 44px;
    max-height: 44px;
    margin-right: 14px;
    background-color: var(--vv-plugin-accent);
    border-radius: 22px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    flex-grow: 0;
    overflow: hidden;
}

.logo {
    width: 44px;
    min-width: 44px;
    max-width: 44px;
    height: 44px;
    min-height: 44px;
    max-height: 44px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
    flex-shrink: 0;
    flex-grow: 0;
}

.header-text {
    flex-direction: column;
    flex-grow: 1;
}

.title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--vv-text);
    margin-bottom: 0;
}

.subtitle {
    font-size: 11px;
    color: var(--vv-text-muted);
    margin-top: 0;
}

.help-text {
    white-space: normal;
    font-size: 11px;
    color: var(--vv-text-muted);
    margin-bottom: 14px;
    -unity-text-align: middle-left;
}

.missing-container {
    align-items: center;
    justify-content: center;
    padding: 24px;
    display: none;
}

.missing-message {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--vv-text);
    margin-bottom: 6px;
}

.missing-detail {
    white-space: normal;
    font-size: 11px;
    color: var(--vv-text-muted);
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.form-container {
    flex-direction: column;
    display: none;
}

.path-label {
    font-size: 10px;
    color: var(--vv-text-faint);
    margin-bottom: 8px;
    -unity-font-style: italic;
}

.button-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 14px;
    margin-bottom: 6px;
}

.primary-button {
    background-color: var(--vv-plugin-accent);
    color: var(--vv-plugin-accent-text);
    -unity-font-style: bold;
    padding: 7px 14px;
    margin-left: 8px;
    border-width: 0;
    border-radius: 6px;
}

.primary-button:hover {
    background-color: var(--vv-plugin-accent-hover);
}

.secondary-button {
    background-color: rgba(0, 0, 0, 0);
    color: var(--vv-text);
    padding: 7px 14px;
    margin-left: 8px;
    border-width: 1px;
    border-color: var(--vv-plugin-accent);
    border-radius: 6px;
}

.secondary-button:hover {
    background-color: var(--vv-plugin-accent-soft);
    color: var(--vv-plugin-accent);
}

.status-label {
    margin-top: 6px;
    white-space: normal;
    font-size: 11px;
}
