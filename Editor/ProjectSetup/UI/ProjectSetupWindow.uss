/* Project Setup — VirtualVenues themed.
   Class names are unchanged (C# builds rows from them); the look is rebuilt on the
   shared tokens from VVTheme.uss (added as the base sheet by VVEditorUI.ApplyTheme). */

.ps-container {
    padding: 12px;
    flex-grow: 1;
}

.ps-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--vv-text);
    margin-bottom: 4px;
}

.ps-intro {
    font-size: 11px;
    color: var(--vv-text-muted);
    white-space: normal;
    margin-bottom: 8px;
}

.ps-summary {
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
    padding: 8px;
    margin-bottom: 8px;
    background-color: var(--vv-inset);
    border-radius: 8px;
}

.ps-checklist-scroll {
    flex-grow: 1;
    min-height: 180px;
    margin-bottom: 8px;
}

/* One requirement row */
.setup-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin: 4px 0;
    background-color: var(--vv-surface);
    border-width: 1px;
    border-color: var(--vv-border);
    border-radius: 10px;
}

.setup-row:hover {
    background-color: var(--vv-surface-hover);
}

.setup-row-icon {
    width: 18px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 8px;
}

.setup-row-title {
    font-size: 12px;
    color: var(--vv-text);
}

.setup-row-detail {
    font-size: 10px;
    color: var(--vv-text-muted);
    white-space: normal;
}

.setup-row-fix {
    width: 56px;
    height: 22px;
    margin-left: 6px;
    border-radius: 6px;
}

.setup-row-fix:disabled {
    opacity: 0.4;
}

/* Action buttons */
.ps-buttons {
    flex-direction: row;
    margin: 4px 0 8px 0;
}

.ps-primary {
    flex-grow: 1;
    height: 30px;
    background-color: var(--vv-primary);
    color: var(--vv-text-on-accent);
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 6px;
}

.ps-primary:hover {
    background-color: var(--vv-primary-hover);
}

.ps-primary:disabled {
    background-color: var(--vv-disabled-bg);
    color: var(--vv-disabled-text);
}

.ps-secondary {
    width: 90px;
    height: 30px;
    margin-left: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--vv-accent);
    border-width: 1px;
    border-color: var(--vv-accent);
    border-radius: 6px;
}

.ps-secondary:hover {
    background-color: var(--vv-accent-soft);
}

/* Log */
.ps-log-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--vv-text-muted);
    margin-bottom: 2px;
}

.ps-log {
    min-height: 80px;
    max-height: 140px;
    background-color: var(--vv-inset);
    border-radius: 8px;
    padding: 4px 6px;
}

.ps-log Label {
    font-size: 10px;
    color: var(--vv-text-muted);
    white-space: normal;
    margin: 1px 0;
}
