/* Asset Pack Publisher — VirtualVenues themed.
   Shares the VVTheme.uss tokens (added as the base sheet by VVEditorUI). Class names mirror
   the World / Avatar publishers so the look stays consistent across the SDK tool windows. */

.main-container {
    padding: 10px;
    flex-grow: 1;
}

/* Cards */
.section {
    margin-bottom: 16px;
    padding: 12px;
    background-color: var(--vv-surface);
    border-width: 1px;
    border-color: var(--vv-border);
    border-radius: 10px;
}

/* Plain group (Pack / Assets / Published Packs), not a card: the publisher card is one flat surface. */
.subsection {
    margin: 4px 0;
    padding: 0;
}

.divider {
    height: 1px;
    background-color: var(--vv-border);
    margin: 8px 0;
}

.subsection-title {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    color: var(--vv-text-muted);
}

/* Authentication */
#auth-section {
    padding: 8px;
}

.auth-row {
    flex-direction: row;
    align-items: center;
}

.user-greeting {
    flex-grow: 1;
    font-size: 14px;
    -unity-font-style: bold;
    margin: 0;
    color: var(--vv-success);
}

.auth-button {
    width: 100px;
    height: 26px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--vv-accent);
    -unity-font-style: bold;
    border-width: 1px;
    border-color: var(--vv-accent);
    border-radius: 6px;
}

.auth-button:hover {
    background-color: var(--vv-accent-soft);
}

.device-flow-container {
    margin: 10px 0;
    padding: 10px;
    background-color: var(--vv-accent-soft);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--vv-accent);
}

.code-field {
    flex-grow: 1;
    margin: 0 5px 0 0;
    -unity-font-style: bold;
    background-color: var(--vv-inset);
}

.link-button {
    color: var(--vv-accent);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-left;
    cursor: link;
}

.link-button:hover {
    color: var(--vv-accent-teal);
}

.copy-button {
    width: 50px;
    height: 20px;
}

.auth-result {
    margin: 10px 0;
    padding: 8px;
    border-radius: 6px;
}

.auth-result-error {
    color: var(--vv-danger);
    background-color: var(--vv-danger-soft);
}

.auth-result-success {
    color: var(--vv-success);
    background-color: var(--vv-primary-soft);
}

/* Pack metadata fields */
.text-input {
    margin: 2px 0 8px 0;
    height: 22px;
}

IntegerField {
    margin: 2px 0 8px 0;
}

/* Inline label + control row */
.field-row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
}

.field-row-label {
    width: 110px;
    flex-shrink: 0;
    -unity-font-style: bold;
    color: var(--vv-text-muted);
}

.field-row > .text-input,
.field-row > IntegerField {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

/* Code-built "Editing Pack" ObjectField: same label column as the .field-row rows under it. */
.pack-def-field {
    margin: 4px 0;
}

.pack-def-field > .unity-base-field__label {
    width: 110px;
    min-width: 110px;
    padding-left: 0;
    -unity-font-style: bold;
    color: var(--vv-text-muted);
}

/* Assets list */
.assets-container {
    margin: 4px 0;
}

.asset-row {
    margin: 4px 0;
    padding: 8px;
    background-color: var(--vv-inset);
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--vv-border);
}

.asset-row-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.asset-row-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--vv-text-muted);
}

.asset-object-field {
    margin: 2px 0;
    height: 22px;
}

.remove-asset-button {
    width: 64px;
    height: 20px;
    font-size: 11px;
    color: var(--vv-danger);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--vv-danger-soft);
    border-radius: 6px;
}

.remove-asset-button:hover {
    background-color: var(--vv-danger-soft);
    color: var(--vv-danger-hover);
}

.add-asset-button {
    height: 24px;
    margin: 6px 0 2px 0;
    align-self: flex-start;
    padding: 0 12px;
    font-size: 11px;
}

.asset-row-error {
    color: var(--vv-warning);
    font-size: 11px;
    margin-top: 4px;
    white-space: normal;
}

/* Assets — drop zone */
.asset-drop-zone {
    margin: 4px 0 6px 0;
    padding: 10px;
    align-items: center;
    justify-content: center;
    background-color: var(--vv-surface);
    border-width: 1px;
    border-color: var(--vv-border-strong);
    border-radius: 6px;
}

.asset-drop-zone:hover {
    border-color: var(--vv-accent);
    background-color: var(--vv-accent-soft);
}

.asset-drop-zone-label {
    color: var(--vv-text-muted);
    font-size: 11px;
    -unity-font-style: italic;
}

/* Assets — bulk ops bar (checkbox column) */
.bulk-bar {
    flex-direction: row;
    align-items: center;
    margin: 2px 0 4px 0;
    padding: 4px 8px;
    background-color: var(--vv-surface-strong);
    border-radius: 6px;
}

.bulk-all-toggle {
    margin-right: 10px;
}

.bulk-count-label {
    flex-grow: 1;
    font-size: 11px;
    color: var(--vv-text-muted);
}

.asset-cell-select {
    align-items: center;
    justify-content: center;
    margin: 0;
}

.asset-cell-unbound {
    color: var(--vv-warning);
}

/* Remote mode (editing a published pack loaded from the backend) */
.remote-banner {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
    padding: 8px 10px;
    background-color: var(--vv-accent-soft);
    border-width: 1px;
    border-color: var(--vv-accent);
    border-radius: 6px;
}

.remote-banner-label {
    flex-grow: 1;
    font-size: 11px;
    color: var(--vv-text);
    white-space: normal;
}

.remote-tags-warning {
    color: var(--vv-warning);
    font-size: 11px;
    margin: 2px 0 4px 0;
    white-space: normal;
}

/* Assets — master/detail layout */
.asset-master-detail {
    flex-direction: row;
    height: 300px;
    margin: 4px 0;
}

.asset-list {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 150px;
    background-color: var(--vv-inset);
    border-width: 1px;
    border-color: var(--vv-border);
    border-radius: 6px;
}

.asset-detail {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 180px;
    margin-left: 8px;
    padding: 8px;
    background-color: var(--vv-surface-strong);
    border-radius: 6px;
}

/* Assets — list cells */
.asset-cell-label {
    -unity-text-align: middle-left;
    color: var(--vv-text);
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.asset-cell-icon {
    width: 26px;
    height: 26px;
}

.asset-list .unity-collection-view__item--selected {
    background-color: var(--vv-accent-soft);
}

/* Assets — detail pane */
.asset-detail-hint {
    color: var(--vv-text-muted);
    font-size: 11px;
    white-space: normal;
    -unity-font-style: italic;
}

.asset-detail-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.asset-detail-preview {
    width: 96px;
    height: 96px;
    margin-right: 8px;
    background-color: var(--vv-inset);
    border-radius: 6px;
}

.asset-detail-title {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--vv-text-muted);
}

/* Buttons */
.button-section {
    margin: 14px 0;
}

.primary-button {
    height: 30px;
    margin: 5px 0;
    background-color: var(--vv-primary);
    color: var(--vv-text-on-accent);
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 6px;
}

.primary-button:hover {
    background-color: var(--vv-primary-hover);
}

.primary-button:disabled {
    background-color: var(--vv-disabled-bg);
    color: var(--vv-disabled-text);
}

/* Progress */
.progress-section {
    margin: 10px 0;
    padding: 10px;
    background-color: var(--vv-inset);
    border-radius: 8px;
}

.progress-bar {
    height: 20px;
    margin: 5px 0;
}

.progress-bar > .unity-progress-bar__background {
    background-color: var(--vv-inset);
    border-radius: 6px;
}

.progress-bar > .unity-progress-bar__progress {
    background-color: var(--vv-primary);
    border-radius: 6px;
}

/* Status / info */
.status-box {
    margin: 8px 0;
    padding: 10px;
    border-radius: 8px;
    white-space: normal;
}

.status-info {
    background-color: var(--vv-surface-strong);
    color: var(--vv-text-muted);
}

.status-error {
    background-color: var(--vv-danger-soft);
    color: var(--vv-danger);
}

.status-success {
    background-color: var(--vv-primary-soft);
    color: var(--vv-success);
}

.error-label {
    color: var(--vv-danger);
    font-size: 11px;
    margin-top: 4px;
    white-space: normal;
}

/* Published packs (read-only backend list) — mirrors the Avatar publisher's catalog cards */
.pack-list-container {
    padding: 4px 0;
}

.pack-card {
    padding: 8px;
    margin: 4px 0;
    background-color: var(--vv-surface);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--vv-border);
}

.pack-card:hover {
    background-color: var(--vv-surface-hover);
}

.pack-card-highlight {
    border-color: var(--vv-primary);
}

.pack-card-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.pack-card-info {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.pack-name-row {
    flex-direction: row;
    align-items: center;
}

.pack-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--vv-text);
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.pack-id {
    font-size: 9px;
    color: var(--vv-text-faint);
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.pack-card-buttons {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.pack-version {
    font-size: 10px;
    color: var(--vv-success);
    background-color: var(--vv-primary-soft);
    padding: 2px 8px;
    border-radius: 999px;
    margin-left: 6px;
    flex-shrink: 0;
}

.action-button {
    height: 24px;
    min-width: 60px;
    margin-left: 6px;
    font-size: 11px;
    border-radius: 6px;
}

/* Helpers */
.row {
    flex-direction: row;
    align-items: center;
    margin: 5px 0;
}

Label {
    margin: 2px 0;
    color: var(--vv-text);
}

TextField {
    margin: 2px 0;
}

Button {
    margin: 2px 0;
}

/* Version label — re-parented into the brand header row from C# (CreateGUI). */
.version-label {
    margin-left: auto;
    align-self: flex-start;
    font-size: 10px;
    color: var(--vv-text-faint);
    -unity-text-align: middle-right;
}
