/* Avatar Publisher — VirtualVenues themed.
   Class names are unchanged (C# bindings rely on them); only the look is rebuilt
   on the shared tokens from VVTheme.uss (added as the base sheet by VVEditorUI). */

.main-container {
    padding: 10px;
    flex-grow: 1;
}

.section {
    margin-bottom: 12px;
    padding: 12px;
    background-color: var(--vv-surface);
    border-width: 1px;
    border-color: var(--vv-border);
    border-radius: 10px;
}

/* Only auto-build-section / manual-bundle-section keep this; it is a plain group, not a card,
   so the publisher section reads as one flat surface. */
.subsection {
    margin: 4px 0;
    padding: 0;
}

.divider {
    height: 1px;
    background-color: var(--vv-border);
    margin: 8px 0;
}

.subsection-title {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    color: var(--vv-text-muted);
}

/* Authentication */
#auth-section {
    padding: 8px;
}

.auth-row {
    flex-direction: row;
    align-items: center;
}

.user-greeting {
    flex-grow: 1;
    font-size: 14px;
    -unity-font-style: bold;
    margin: 0;
    color: var(--vv-success);
}

.auth-button {
    width: 100px;
    height: 26px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--vv-accent);
    -unity-font-style: bold;
    border-width: 1px;
    border-color: var(--vv-accent);
    border-radius: 6px;
}

.auth-button:hover {
    background-color: var(--vv-accent-soft);
}

.device-flow-container {
    margin: 10px 0;
    padding: 10px;
    background-color: var(--vv-accent-soft);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--vv-accent);
}

.code-field {
    flex-grow: 1;
    margin: 0 5px;
    -unity-font-style: bold;
    background-color: var(--vv-inset);
}

.link-button {
    color: var(--vv-accent);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-left;
    cursor: link;
}

.link-button:hover {
    color: var(--vv-accent-teal);
}

.auth-result {
    margin: 10px 0;
    padding: 8px;
    border-radius: 6px;
}

.auth-result-error {
    color: var(--vv-danger);
    background-color: var(--vv-danger-soft);
}

.auth-result-success {
    color: var(--vv-success);
    background-color: var(--vv-primary-soft);
}

/* Catalog mode */
.catalog-mode-group {
    margin: 5px 0;
}

/* RadioButtonGroup nests its buttons in an inner container; target it (not the group root)
   so the options lay out horizontally. */
.catalog-mode-group .unity-radio-button-group__container {
    flex-direction: row;
}

.catalog-mode-group RadioButton {
    margin-right: 15px;
    margin-bottom: 0;
}

.catalog-name-input {
    margin: 5px 0;
    height: 24px;
}

.catalog-dropdown {
    margin: 5px 0;
    height: 24px;
}

.version-tag-input {
    margin: 5px 0;
    height: 24px;
}

/* Build mode */
.build-mode-group {
    margin: 5px 0;
}

.build-mode-group .unity-radio-button-group__container {
    flex-direction: row;
}

.build-mode-group RadioButton {
    margin-right: 15px;
    margin-bottom: 0;
}

/* Prefab selection */
.prefab-foldout {
    margin: 5px 0;
    padding: 5px;
    background-color: var(--vv-surface);
    border-radius: 6px;
}

.prefab-foldout > Toggle {
    margin-bottom: 5px;
}

.prefab-container {
    padding: 5px;
}

.prefab-row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
    padding: 4px;
    background-color: var(--vv-inset);
    border-radius: 6px;
}

.prefab-object-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 22px;
}

/* Cosmetic slot dropdown/text field: fixed width; the ObjectField beside it shrinks to fit. */
.slot-field {
    flex-grow: 0;
    flex-shrink: 0;
    width: 120px;
    height: 22px;
    margin-left: 4px;
}

.remove-prefab-button {
    width: 22px;
    height: 22px;
    font-size: 14px;
    color: var(--vv-danger);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin-left: 4px;
}

.remove-prefab-button:hover {
    color: var(--vv-danger-hover);
}

.add-prefab-button {
    height: 24px;
    margin-top: 5px;
    color: var(--vv-primary);
    background-color: var(--vv-primary-soft);
    border-width: 1px;
    border-color: var(--vv-primary);
    border-radius: 6px;
}

.add-prefab-button:hover {
    background-color: rgba(16, 185, 129, 0.28);
}

/* Bundle folder */
.bundle-folder-input {
    flex-grow: 1;
    margin-right: 5px;
    height: 24px;
}

.browse-button {
    width: 80px;
    height: 24px;
}

.bundle-files-section {
    margin-top: 8px;
    padding: 8px;
    background-color: var(--vv-inset);
    border-radius: 6px;
}

.file-counter {
    font-size: 12px;
    color: var(--vv-text-muted);
    margin-bottom: 5px;
    -unity-font-style: italic;
}

.bundle-list-scroll {
    max-height: 120px;
    min-height: 40px;
}

.bundle-list-container {
    padding: 2px;
}

.bundle-item {
    padding: 3px 6px;
    margin: 2px 0;
    background-color: var(--vv-surface);
    border-radius: 6px;
    flex-direction: row;
    align-items: center;
}

.bundle-item-name {
    flex-grow: 1;
    font-size: 11px;
    color: var(--vv-text-muted);
}

.bundle-item-size {
    font-size: 10px;
    color: var(--vv-text-faint);
    margin-left: 8px;
}

.bundle-item-required {
    color: var(--vv-success);
}

/* Metadata foldouts */
.metadata-foldout {
    margin: 5px 0;
    padding: 5px;
    background-color: var(--vv-surface);
    border-radius: 6px;
}

.metadata-foldout > Toggle {
    margin-bottom: 5px;
}

.metadata-container {
    padding: 5px;
}

.metadata-entry {
    margin: 5px 0;
    padding: 8px;
    background-color: var(--vv-inset);
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--vv-border);
}

.metadata-entry-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 5px;
}

.metadata-entry-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--vv-text-muted);
}

.metadata-field-row {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
}

.metadata-field-label {
    width: 45px;
    font-size: 11px;
    color: var(--vv-text-muted);
}

.metadata-field {
    flex-grow: 1;
    height: 20px;
    font-size: 11px;
}

.remove-metadata-button {
    width: 22px;
    height: 22px;
    font-size: 14px;
    color: var(--vv-danger);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.remove-metadata-button:hover {
    color: var(--vv-danger-hover);
}

.add-metadata-button {
    height: 24px;
    margin-top: 5px;
    color: var(--vv-accent);
    background-color: var(--vv-accent-soft);
    border-width: 1px;
    border-color: var(--vv-accent);
    border-radius: 6px;
}

.add-metadata-button:hover {
    background-color: rgba(34, 211, 238, 0.24);
}

/* Buttons */
.button-section {
    margin: 8px 0;
}

.primary-button {
    height: 30px;
    margin: 5px 0;
    background-color: var(--vv-primary);
    color: var(--vv-text-on-accent);
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 6px;
}

.primary-button:hover {
    background-color: var(--vv-primary-hover);
}

.primary-button:disabled {
    background-color: var(--vv-disabled-bg);
    color: var(--vv-disabled-text);
}

.danger-button {
    background-color: rgba(0, 0, 0, 0);
    color: var(--vv-danger);
    border-width: 1px;
    border-color: var(--vv-danger-soft);
    border-radius: 6px;
}

.danger-button:hover {
    background-color: var(--vv-danger-soft);
    color: var(--vv-danger-hover);
}

/* Progress */
.progress-section {
    margin: 10px 0;
    padding: 10px;
    background-color: var(--vv-inset);
    border-radius: 8px;
}

.progress-bar {
    height: 20px;
    margin: 5px 0;
}

.progress-bar > .unity-progress-bar__background {
    background-color: var(--vv-inset);
    border-radius: 6px;
}

.progress-bar > .unity-progress-bar__progress {
    background-color: var(--vv-primary);
    border-radius: 6px;
}

/* Helpers */
.row {
    flex-direction: row;
    align-items: center;
    margin: 5px 0;
}

/* Inline label + control row (condensed layout) */
.field-row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
}

.field-row-label {
    width: 90px;
    flex-shrink: 0;
    -unity-font-style: bold;
    color: var(--vv-text-muted);
}

.field-row > .catalog-name-input,
.field-row > .catalog-dropdown,
.field-row > .version-tag-input {
    flex-grow: 1;
}

/* Two metadata fields side by side */
.metadata-field-pair {
    flex-direction: row;
    margin: 3px 0;
}

.metadata-field-pair > .metadata-field-row {
    flex-grow: 1;
    min-width: 120px;
    margin: 0;
}

/* Drag-and-drop hint inside the prefab foldouts */
.drag-hint {
    font-size: 10px;
    color: var(--vv-text-faint);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 6px;
    padding: 8px;
    border-width: 1px;
    border-color: var(--vv-border);
    border-radius: 6px;
}

/* Long per-avatar slot summary inside the cosmetic foldout */
.slot-summary {
    white-space: normal;
}

Label {
    margin: 2px 0;
    color: var(--vv-text);
}

TextField {
    margin: 2px 0;
}

Button {
    margin: 2px 0;
}

/* Version label — re-parented into the brand header row from C# (CreateGUI). */
.version-label {
    margin-left: auto;
    align-self: flex-start;
    font-size: 10px;
    color: var(--vv-text-faint);
    -unity-text-align: middle-right;
}

/* Catalog list */
.catalog-list-container {
    padding: 5px 0;
}

/* Catalog cards */
.catalog-card {
    padding: 8px;
    margin: 4px 0;
    background-color: var(--vv-surface);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--vv-border);
}

.catalog-card:hover {
    background-color: var(--vv-surface-hover);
}

.catalog-card-highlight {
    border-color: var(--vv-primary);
    border-width: 1px;
}

.catalog-card-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}

.catalog-card-info {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.catalog-name-row {
    flex-direction: row;
    align-items: center;
}

.catalog-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--vv-text);
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.catalog-id {
    font-size: 9px;
    color: var(--vv-text-faint);
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.catalog-name-edit {
    flex-grow: 1;
    margin-right: 5px;
    height: 22px;
}

.catalog-date {
    font-size: 10px;
    color: var(--vv-text-muted);
}

.catalog-card-buttons {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.catalog-version-tag {
    font-size: 10px;
    color: var(--vv-success);
    background-color: var(--vv-primary-soft);
    padding: 2px 8px;
    border-radius: 999px;
    margin-left: 6px;
    flex-shrink: 0;
}

.action-button {
    height: 24px;
    min-width: 60px;
    margin-left: 6px;
    font-size: 11px;
    border-radius: 6px;
}

.inline-button {
    height: 22px;
    min-width: 50px;
    margin-left: 4px;
    font-size: 11px;
    border-radius: 6px;
}

/* Error label */
.error-label {
    color: var(--vv-danger);
    font-size: 11px;
    margin-top: 4px;
    white-space: normal;
}

/* Empty-state label (catalog list) */
.empty-label {
    font-size: 11px;
    color: var(--vv-text-muted);
    -unity-font-style: italic;
    padding: 6px 0;
    white-space: normal;
}

/* Copy button */
.copy-button {
    width: 50px;
    height: 20px;
}
